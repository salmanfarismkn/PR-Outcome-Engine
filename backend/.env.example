APP_NAME=PR Outcome Engine
DEBUG=false

# Local host-run backend. Replace the password placeholder with the
# URL-encoded password configured for the local PostgreSQL service.
DATABASE_URL=postgresql+psycopg://postgres:URL_ENCODED_PASSWORD@127.0.0.1:5432/pr_outcome_engine
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

API_READ_TOKEN=
API_ADMIN_TOKEN=

# Automatic recovery is disabled by default. Run one dedicated recovery
# process only after setting this to true.
WEBHOOK_RECOVERY_ENABLED=false
WEBHOOK_RECOVERY_INTERVAL_SECONDS=300
WEBHOOK_RECOVERY_STALE_MINUTES=15
WEBHOOK_RECOVERY_MAX_ATTEMPTS=3
WEBHOOK_RECOVERY_BATCH_LIMIT=50
