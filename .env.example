# Compose interpolation values. Copy to .env and set both passwords to
# distinct random URL-safe values. Compose refuses blank passwords.
POSTGRES_DB=pr_sentinel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5432

PGADMIN_DEFAULT_EMAIL=developer@example.invalid
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_HOST_PORT=8080
